          {
            "tipo": "domicilio-fme",
            "id": "domicilio-real",
            "label": "Domicilio real"
          }
        ]
      },
      {
        "titulo": "Condición fiscal y actividad",
        "campos": [
          {
            "tipo": "select",
            "id": "condicion-iva",
            "label": "Condición frente al IVA",
            "placeholder": "Seleccioná una opción",
            "opciones": [
              "Responsable inscripto",
              "Monotributista",
              "Exento",
              "No responsable",
              "Consumidor final",
              "No categorizado"
            ]
          },
          {
            "tipo": "select",
            "id": "ingresos-brutos",
            "label": "Situación en Ingresos Brutos",
            "placeholder": "Seleccioná una opción",
            "opciones": [
              "Inscripto local Catamarca",
              "Convenio multilateral",
              "Exento",
              "No inscripto / en trámite"
