  "habilitacion-comercial": {
    "titulo": "Alta de contribuyente comercial",
    "pasos": [
      {
        "titulo": "Datos del contribuyente",
        "campos": [
          {
            "tipo": "select",
            "id": "tipo-contribuyente",
            "label": "Persona física o jurídica",
            "placeholder": "Seleccioná una opción",
            "opciones": [
              "Persona física",
              "Persona jurídica"
            ]
          },
          {
            "tipo": "select",
            "id": "tipo-societario",
            "label": "Tipo societario (si corresponde)",
