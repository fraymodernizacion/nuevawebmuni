            "fuenteDatos": "mock/actividades-arca.json",
            "totalOpciones": 958,
            "ayuda": "Listado completo importado desde ACTIVIDADES_ECONOMICAS_F883."
          },
          {
            "tipo": "select",
            "id": "actividad-principal",
            "label": "La actividad seleccionada es",
            "placeholder": "Seleccioná una opción",
            "opciones": [
              "Principal",
              "Secundaria"
            ]
          },
          {
            "tipo": "fecha",
            "id": "fecha-alta-actividades",
            "label": "Fecha de alta de actividades"
          }
        ]
      },
      {
        "titulo": "Casa central o sucursal",
        "campos": [
          {
            "tipo": "texto",
            "id": "nombre-fantasia",
            "label": "Nombre de fantasía"
          },
          {
            "tipo": "fecha",
            "id": "fecha-alta-sucursal",
            "label": "Fecha de alta"
          },
          {
            "tipo": "domicilio-fme",
            "id": "domicilio-comercio",
            "label": "Domicilio donde se desarrolla la actividad"
          },
          {
            "tipo": "texto",
            "id": "matricula-catastral",
            "label": "Matrícula catastral",
            "placeholder": "Formato: 09-_--_-0000 o 09-_--_-PA00"
          },
          {
            "tipo": "select",
            "id": "caracter-domicilio",
            "label": "Caracter del domicilio",
            "placeholder": "Seleccioná una opción",
            "opciones": [
              "Propio",
              "Alquilado",
              "Cedido",
              "Comodato",
              "Otro"
            ]
          },
          {
            "tipo": "select",
            "id": "tipo-local",
            "label": "Tipo de espacio comercial",
            "placeholder": "Seleccioná una opción",
            "opciones": [
              "Local a la calle",
              "Local dentro de vivienda",
              "Oficina",
              "Depósito",
              "Puesto fijo",
              "Puesto móvil",
              "Venta online sin atención al público",
              "Otro"
            ]
          },
          {
            "tipo": "select",
            "id": "atencion-publico",
            "label": "Atención al público en el domicilio",
            "placeholder": "Seleccioná una opción",
            "opciones": [
              "Sí",
              "No",
              "Solo retiro / entrega",
              "A confirmar por inspección"
            ]
          }
        ]
      },
      {
        "titulo": "Ubicación del comercio",
        "campos": [
          {
            "tipo": "select",
            "id": "requiere-mapa",
            "label": "¿Corresponde marcar ubicación en el mapa?",
            "placeholder": "Seleccioná una opción",
            "opciones": [
              "Sí, el comercio funciona en un domicilio físico",
              "No, actividad sin local físico",
              "No sabe / solicita orientación"
            ]
          },
          {
            "tipo": "gps",
            "id": "ubicacion-comercio",
            "label": "Marcá la ubicación exacta del comercio"
          }
        ]
      },
      {
        "titulo": "Documentación y declaración",
        "campos": [
          {
            "tipo": "adjuntos",
            "id": "dni",
            "label": "Adjuntar DNI o documentación societaria"
          },
          {
            "tipo": "adjuntos",
            "id": "cuit",
            "label": "Adjuntar constancia de CUIT / inscripción ARCA"
          },
          {
            "tipo": "adjuntos",
            "id": "cedula-fiscal",
            "label": "Adjuntar cédula fiscal"
          },
          {
            "tipo": "adjuntos",
            "id": "acta-autoridades",
            "label": "Adjuntar acta de designación de autoridades (persona jurídica)"
          },
          {
            "tipo": "adjuntos",
            "id": "domicilio",
            "label": "Adjuntar respaldo del domicilio comercial"
          },
          {
            "tipo": "adjuntos",
            "id": "representante",
            "label": "Adjuntar DNI del representante, si corresponde"
          },
          {
            "tipo": "textarea",
            "id": "observaciones",
            "label": "Observaciones",
            "placeholder": "Agregá aclaraciones para Mesa de Entrada o Rentas"
          },
          {
            "tipo": "check",
            "id": "declaracion",
            "label": "Declaro que los datos ingresados son correctos y autorizo la verificación municipal correspondiente"
          }
        ]
      }
    ]
  },
