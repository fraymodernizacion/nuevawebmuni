              "No corresponde",
              "Sociedad anónima (S.A.)",
              "Sociedad de responsabilidad limitada (S.R.L.)",
              "Sociedad por acciones simplificada (S.A.S.)",
              "Sociedad de hecho",
              "Cooperativa",
              "Asociación civil",
              "Fundación",
              "Otro"
            ]
          },
          {
            "tipo": "select",
            "id": "tipo-documento",
            "label": "Documento",
            "placeholder": "Seleccioná una opción",
            "opciones": [
              "DNI",
              "CUIT",
              "CUIL",
              "CDI",
              "Pasaporte"
            ]
          },
          {
            "tipo": "texto",
            "id": "cuit",
            "label": "CUIT"
          },
          {
            "tipo": "texto",
            "id": "razon-social",
            "label": "Nombre y apellido o denominación"
          },
          {
            "tipo": "telefono",
            "id": "telefono",
            "label": "Número de celular"
          },
          {
            "tipo": "email",
            "id": "email",
            "label": "Email"
          }
        ]
      },
      {
        "titulo": "Domicilio real del contribuyente",
